# Real connection details for the existing "idblms" MSSQL database (Lms_* tables).
DB_SERVER=172.16.1.173
DB_PORT=54321
DB_NAME=idblms
DB_USER=Testuser
DB_PASSWORD=123$Testuser
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Redis holds in-progress exam answers (so a dropped connection can resume
# instead of reattempting); MSSQL is only written once, on final submit.
REDIS_URL=redis://localhost:6379

# AI learning assistant: Claude answers; embeddings for the knowledge base
# (dbo.Lms_ContentEmbeddings — see server/sql/2026_ai_embeddings.sql and
# `npm run embeddings:backfill`) run locally via lib/embeddings.js — no key,
# no external API, no per-question cost regardless of participant volume.
# Without ANTHROPIC_API_KEY, /api/ai/ask falls back to keyword matching.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
